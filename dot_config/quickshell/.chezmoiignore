# Quickshell dev artifacts – kept on disk, not versioned in dotfiles.
# Scoped to .config/quickshell (this file only applies to this subdirectory).
# Global ** patterns in the top-level .chezmoiignore already cover these;
# listed here explicitly so `chezmoi ignored` is self-documenting per project.

.config/quickshell/.git
.config/quickshell/.git/**
.config/quickshell/.pytest_cache
.config/quickshell/.pytest_cache/**
.config/quickshell/**/target
.config/quickshell/**/target/**
.config/quickshell/**/__pycache__
.config/quickshell/**/__pycache__/**
.config/quickshell/**/*.pyc
# Desktop-context collector databases: private activity data (never deploy).
.config/quickshell/**/*.db
.config/quickshell/**/*.db-wal
.config/quickshell/**/*.db-shm
.config/quickshell/**/*.db-journal
.config/quickshell/**/*.db.lock
