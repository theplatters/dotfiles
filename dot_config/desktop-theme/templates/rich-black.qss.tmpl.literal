/* Rich Black Qt 6 stylesheet (Fusion style).
 *
 * Source template for desktop-theme/generate.py. Every color and radius
 * is a {name} placeholder substituted from quickshell/theme/Theme.qml at
 * render time, so this file itself carries no literal colors.
 *
 * Design language: flat and opaque monochrome. Window background is bg;
 * elevated bars (menubar, toolbar, statusbar, tabbar) are base; controls
 * and floating overlays (buttons, entries, menus, popovers, tooltips)
 * are mantle with a 1px border border; hover is surface0; pressed is
 * surface1; scrollbar handles and strong separators are surface2.
 * accent marks selection, checked/toggled state, default buttons and
 * progress fill, with dark bg text on top; accentMuted is the
 * muted-active variant. Focus is a 2px focusBorder ring. No gradients,
 * no images, no decorative shadows.
 */

/* ================= Windows and dialogs ================= */
QMainWindow {
    background-color: {{bg}};
}
QDialog {
    background-color: {{bg}};
    border: 1px solid {{border}};
    border-radius: {{cardRadius}}px;
}
QMainWindow::separator:horizontal {
    height: 1px;
    background: none;
    background-color: {{border}};
    border: none;
}
QMainWindow::separator:vertical {
    width: 1px;
    background: none;
    background-color: {{border}};
    border: none;
}
/* Structural containers: flat and square. Empty regions must never
 * render as filled rounded bars -- separators are 1px lines or
 * transparent, stacked widgets and docks take the flat window tones. */
QDockWidget {
    background-color: {{base}};
    color: {{text}};
    border: none;
}
QDockWidget::separator {
    background: none;
    border: none;
}
QDockWidget::title {
    background-color: {{base}};
    color: {{text}};
    border: none;
    padding: 4px;
}
QStackedWidget {
    background-color: {{bg}};
    border: none;
}
/* KDE file-manager navigation (Dolphin): the breadcrumb navigator and
 * its buttons are structural chrome, not filled bars. */
KUrlNavigator {
    background: none;
    background-color: {{base}};
    border: none;
}
KUrlNavigatorButton {
    background: none;
    color: {{text}};
    border: none;
    border-radius: {{chipRadius}}px;
    padding: 4px 8px;
}
KUrlNavigatorButton:hover {
    background-color: {{surface0}};
    color: {{text}};
}
QLabel:disabled {
    color: {{subtext0}};
}

/* ================= Push buttons ================= */
QPushButton {
    background-color: {{mantle}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: {{controlRadius}}px;
    padding: 5px 14px;
    min-height: 28px;
}
QPushButton:hover {
    background-color: {{surface0}};
}
QPushButton:pressed {
    background-color: {{surface1}};
}
QPushButton:open {
    background-color: {{surface1}};
}
QPushButton:checked {
    background-color: {{accent}};
    color: {{bg}};
    border-color: {{accent}};
}
QPushButton:checked:disabled {
    background-color: {{accentMuted}};
    color: {{bg}};
    border-color: {{accentMuted}};
}
QPushButton:disabled {
    background-color: {{mantle}};
    color: {{subtext0}};
    border-color: {{border}};
}
QPushButton:focus {
    border: 2px solid {{focusBorder}};
}
QPushButton:default {
    background-color: {{accent}};
    color: {{bg}};
    border: 1px solid {{accent}};
}
QPushButton:default:hover {
    background-color: {{base3}};
    border-color: {{base3}};
}
QPushButton:default:pressed {
    background-color: {{accentMuted}};
    border-color: {{accentMuted}};
}
QPushButton:default:disabled {
    background-color: {{surface1}};
    color: {{subtext0}};
    border-color: {{surface1}};
}

/* ================= Tool buttons ================= */
QToolButton {
    background-color: {{mantle}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: {{controlRadius}}px;
    padding: 5px;
    min-height: 28px;
    min-width: 28px;
}
QToolButton:hover {
    background-color: {{surface0}};
}
QToolButton:pressed {
    background-color: {{surface1}};
}
QToolButton:open {
    background-color: {{surface1}};
}
QToolButton:checked {
    background-color: {{accent}};
    color: {{bg}};
    border-color: {{accent}};
}
QToolButton:checked:disabled {
    background-color: {{accentMuted}};
    color: {{bg}};
    border-color: {{accentMuted}};
}
QToolButton:disabled {
    background-color: {{mantle}};
    color: {{subtext0}};
    border-color: {{border}};
}
QToolButton:focus {
    border: 2px solid {{focusBorder}};
}

/* ================= Single/multi-line text fields and spins ================= */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox {
    background-color: {{mantle}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: {{controlRadius}}px;
    padding: 5px 10px;
    min-height: 28px;
    selection-background-color: {{accent}};
    selection-color: {{bg}};
}
QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    background-color: {{surface0}};
}
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    background-color: {{mantle}};
    border: 2px solid {{focusBorder}};
}
QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: {{mantle}};
    color: {{subtext0}};
    border-color: {{border}};
}
QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    background-color: {{mantle}};
    border: none;
    width: 24px;
}
QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: {{surface0}};
}
QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::up-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background-color: {{surface1}};
}
QSpinBox::up-button:disabled,
QSpinBox::down-button:disabled,
QDoubleSpinBox::up-button:disabled,
QDoubleSpinBox::down-button:disabled {
    background-color: {{mantle}};
}

/* ================= Combo boxes ================= */
QComboBox {
    background-color: {{mantle}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: {{controlRadius}}px;
    padding: 5px 10px;
    min-height: 28px;
    selection-background-color: {{accent}};
    selection-color: {{bg}};
}
QComboBox:hover {
    background-color: {{surface0}};
}
QComboBox:on,
QComboBox:pressed {
    background-color: {{surface1}};
}
QComboBox:disabled {
    background-color: {{mantle}};
    color: {{subtext0}};
    border-color: {{border}};
}
QComboBox:focus {
    border: 2px solid {{focusBorder}};
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    background-color: {{mantle}};
    border-left: 1px solid {{border}};
    border-top-right-radius: {{controlRadius}}px;
    border-bottom-right-radius: {{controlRadius}}px;
}
QComboBox QAbstractItemView {
    background-color: {{mantle}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: {{largeRadius}}px;
    padding: 4px;
    selection-background-color: {{accent}};
    selection-color: {{bg}};
}
QComboBox QAbstractItemView::item {
    background: none;
    border: none;
    padding: 6px 10px;
}
QComboBox QAbstractItemView::item:hover {
    background-color: {{surface0}};
    color: {{text}};
}
QComboBox QAbstractItemView::item:selected {
    background-color: {{accent}};
    color: {{bg}};
}

/* ================= Check boxes and radio buttons ================= */
QCheckBox,
QRadioButton {
    background: none;
    color: {{text}};
    spacing: 8px;
    min-height: 28px;
}
QCheckBox:disabled,
QRadioButton:disabled {
    color: {{subtext0}};
}
QCheckBox:focus,
QRadioButton:focus {
    border: 2px solid {{focusBorder}};
    border-radius: {{chipRadius}}px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: {{chipRadius}}px;
    background-color: {{mantle}};
    border: 1px solid {{border}};
}
QCheckBox::indicator:hover {
    background-color: {{surface0}};
}
QCheckBox::indicator:pressed {
    background-color: {{surface1}};
}
QCheckBox::indicator:checked {
    background-color: {{accent}};
    border-color: {{accent}};
}
QCheckBox::indicator:checked:disabled {
    background-color: {{accentMuted}};
    border-color: {{accentMuted}};
}
QCheckBox::indicator:disabled {
    background-color: {{mantle}};
    border-color: {{border}};
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border-radius: {{chipRadius}}px;
    background-color: {{mantle}};
    border: 1px solid {{border}};
}
QRadioButton::indicator:hover {
    background-color: {{surface0}};
}
QRadioButton::indicator:pressed {
    background-color: {{surface1}};
}
QRadioButton::indicator:checked {
    background-color: {{accent}};
    border-color: {{accent}};
}
QRadioButton::indicator:checked:disabled {
    background-color: {{accentMuted}};
    border-color: {{accentMuted}};
}
QRadioButton::indicator:disabled {
    background-color: {{mantle}};
    border-color: {{border}};
}

/* ================= Sliders ================= */
QSlider {
    background: none;
}
QSlider:disabled {
    color: {{subtext0}};
}
QSlider::groove:horizontal {
    background-color: {{surface1}};
    height: 6px;
    border-radius: 3px;
}
QSlider::groove:vertical {
    background-color: {{surface1}};
    width: 6px;
    border-radius: 3px;
}
QSlider::groove:horizontal:disabled,
QSlider::groove:vertical:disabled {
    background-color: {{surface1}};
}
QSlider::handle:horizontal {
    background-color: {{mantle}};
    border: 1px solid {{border}};
    width: 14px;
    height: 14px;
    border-radius: {{chipRadius}}px;
    margin: -5px 0;
}
QSlider::handle:vertical {
    background-color: {{mantle}};
    border: 1px solid {{border}};
    width: 14px;
    height: 14px;
    border-radius: {{chipRadius}}px;
    margin: 0 -5px;
}
QSlider::handle:horizontal:hover,
QSlider::handle:vertical:hover {
    background-color: {{surface0}};
}
QSlider::handle:horizontal:pressed,
QSlider::handle:vertical:pressed {
    background-color: {{surface1}};
}
QSlider::handle:horizontal:disabled,
QSlider::handle:vertical:disabled {
    background-color: {{surface0}};
    border-color: {{border}};
}
QSlider::add-page:horizontal,
QSlider::sub-page:horizontal,
QSlider::add-page:vertical,
QSlider::sub-page:vertical {
    background: none;
    border: none;
}

/* ================= Scroll bars ================= */
QScrollBar:vertical {
    background-color: {{bg}};
    border: none;
    width: 14px;
    margin: 0;
}
QScrollBar:horizontal {
    background-color: {{bg}};
    border: none;
    height: 14px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background-color: {{surface2}};
    border: none;
    border-radius: {{chipRadius}}px;
    min-height: 28px;
}
QScrollBar::handle:horizontal {
    background-color: {{surface2}};
    border: none;
    border-radius: {{chipRadius}}px;
    min-width: 28px;
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: {{accentMuted}};
}
QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
    background-color: {{accentMuted}};
}
QScrollBar::handle:vertical:disabled,
QScrollBar::handle:horizontal:disabled {
    background-color: {{surface1}};
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    background: none;
    border: none;
    height: 0;
    width: 0;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
    border: none;
}

/* ================= Menus and menu bar ================= */
QMenuBar {
    background-color: {{base}};
    color: {{text}};
    border: none;
    border-bottom: 1px solid {{border}};
    padding: 2px;
}
QMenuBar::item {
    background: none;
    color: {{text}};
    padding: 6px 12px;
    border-radius: {{chipRadius}}px;
}
QMenuBar::item:selected {
    background-color: {{surface1}};
    color: {{text}};
}
QMenuBar::item:pressed {
    background-color: {{surface1}};
    color: {{text}};
}
QMenuBar::item:disabled {
    background: none;
    color: {{subtext0}};
}
QMenu {
    background-color: {{mantle}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: {{largeRadius}}px;
    padding: 6px;
}
QMenu::item {
    background: none;
    color: {{text}};
    padding: 6px 24px 6px 12px;
    border-radius: {{chipRadius}}px;
}
QMenu::item:selected {
    background-color: {{surface1}};
    color: {{text}};
}
QMenu::item:disabled {
    background: none;
    color: {{subtext0}};
}
QMenu::separator {
    height: 1px;
    background-color: {{surface2}};
    margin: 6px 8px;
}
QMenu::indicator {
    width: 16px;
    height: 16px;
}

/* ================= Tooltips ================= */
QToolTip {
    background-color: {{mantle}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: {{largeRadius}}px;
    padding: 6px 10px;
}

/* ================= Tabs ================= */
QTabWidget {
    background-color: {{bg}};
}
QTabWidget::pane {
    background-color: {{bg}};
    border: 1px solid {{border}};
    border-radius: {{cardRadius}}px;
    padding: 8px;
}
QTabBar::tab {
    background-color: {{base}};
    color: {{subtext1}};
    border: 1px solid {{border}};
    border-radius: {{controlRadius}}px;
    padding: 6px 14px;
    margin: 2px;
    min-height: 24px;
}
QTabBar::tab:hover:!selected {
    background-color: {{surface0}};
    color: {{text}};
}
QTabBar::tab:selected {
    background-color: {{accent}};
    color: {{bg}};
    border-color: {{accent}};
}
QTabBar::tab:disabled {
    background-color: {{mantle}};
    color: {{subtext0}};
    border-color: {{border}};
}
QTabBar::tab:focus {
    border: 2px solid {{focusBorder}};
}

/* ================= Group boxes ================= */
QGroupBox {
    background-color: {{bg}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: {{cardRadius}}px;
    margin-top: 24px;
    padding-top: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    background-color: {{bg}};
    color: {{subtext1}};
    padding: 0 6px;
    margin-left: 12px;
}
QGroupBox:disabled {
    color: {{subtext0}};
}

/* ================= Progress bars ================= */
QProgressBar {
    background-color: {{mantle}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: {{controlRadius}}px;
    text-align: center;
    min-height: 16px;
}
QProgressBar:disabled {
    color: {{subtext0}};
}
QProgressBar::chunk {
    background-color: {{accent}};
}

/* ================= Item views ================= */
QAbstractItemView {
    background-color: {{bg}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: {{controlRadius}}px;
    alternate-background-color: {{surface0}};
    selection-background-color: {{accent}};
    selection-color: {{bg}};
    show-decoration-selected: 1;
}
QAbstractItemView:focus {
    border: 2px solid {{focusBorder}};
}
QAbstractItemView::item {
    background: none;
    border: none;
    padding: 4px;
}
QAbstractItemView::item:hover {
    background-color: {{surface0}};
    color: {{text}};
}
QAbstractItemView::item:selected {
    background-color: {{accent}};
    color: {{bg}};
}
/* Selection is an accent FILL with dark text in every state, including
 * inactive windows -- never an outline, never light-on-light. The
 * per-view rules below repeat it so Dolphin's file views and its
 * KFilePlacesView places sidebar can't fall back to a pale delegate. */
QAbstractItemView::item:selected:active,
QAbstractItemView::item:selected:!active {
    background-color: {{accent}};
    color: {{bg}};
}
QListView::item:selected,
QListView::item:selected:active,
QListView::item:selected:!active,
QTreeView::item:selected,
QTreeView::item:selected:active,
QTreeView::item:selected:!active,
QTableView::item:selected,
QTableView::item:selected:active,
QTableView::item:selected:!active {
    background-color: {{accent}};
    color: {{bg}};
}
/* Dolphin places sidebar (KFilePlacesView is a QListView): accent fill
 * with dark text, readable in active and inactive windows. */
KFilePlacesView {
    background-color: {{base}};
    color: {{text}};
    border: none;
    selection-background-color: {{accent}};
    selection-color: {{bg}};
    show-decoration-selected: 1;
}
KFilePlacesView::item {
    background: none;
    border: none;
    padding: 4px;
}
KFilePlacesView::item:hover {
    background-color: {{surface0}};
    color: {{text}};
}
KFilePlacesView::item:selected,
KFilePlacesView::item:selected:active,
KFilePlacesView::item:selected:!active {
    background-color: {{accent}};
    color: {{bg}};
}
QAbstractItemView::item:selected:disabled {
    background-color: {{accentMuted}};
    color: {{bg}};
}
QAbstractItemView::item:disabled {
    background: none;
    color: {{subtext0}};
}
QListView,
QTreeView,
QTableView {
    alternate-background-color: {{surface0}};
}
QTableView {
    gridline-color: {{border}};
}
QTableCornerButton::section {
    background-color: {{base}};
    border: 1px solid {{border}};
    border-radius: 0px;
}
QTreeView::branch {
    background-color: {{bg}};
}
QTreeView::branch:hover {
    background-color: {{surface0}};
}
QTreeView::branch:selected {
    background-color: {{accent}};
    color: {{bg}};
}

/* ================= Header views ================= */
/* Column/table/tree headers stay FLAT and square: base fill, 1px
 * border, radius 0 -- never rounded pills. */
QHeaderView::section {
    background-color: {{base}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 0px;
    padding: 6px 10px;
}
QHeaderView::section:hover {
    background-color: {{surface0}};
}
QHeaderView::section:pressed,
QHeaderView::section:checked {
    background-color: {{surface1}};
}
QHeaderView::section:disabled {
    background-color: {{base}};
    color: {{subtext0}};
}

/* ================= Tool bars and status bar ================= */
QToolBar {
    background-color: {{base}};
    color: {{text}};
    border: none;
    border-bottom: 1px solid {{border}};
    spacing: 4px;
    padding: 4px;
}
QToolBar:disabled {
    color: {{subtext0}};
}
QToolBar::handle {
    background: none;
    border: none;
}
QToolBar::separator {
    background-color: {{surface2}};
    border: none;
}
QToolBar::separator:horizontal {
    width: 1px;
    margin: 6px 2px;
}
QToolBar::separator:vertical {
    height: 1px;
    margin: 2px 6px;
}
QStatusBar {
    background-color: {{base}};
    color: {{subtext1}};
    border-top: 1px solid {{border}};
}
QStatusBar::item {
    background: none;
    border: none;
}

/* ================= Splitters and dials ================= */
QSplitter::handle {
    background-color: {{surface2}};
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:vertical {
    height: 2px;
}
QSplitter::handle:hover {
    background-color: {{accentMuted}};
}
QSplitter::handle:pressed {
    background-color: {{accent}};
}
QDial {
    background-color: {{mantle}};
}
QDial:disabled {
    background-color: {{surface0}};
}
